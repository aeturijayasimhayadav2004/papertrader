# Copy to .env and fill in. NEVER commit .env.
# Bot uses the SERVICE ROLE / SECRET key (write access). Keep it off the dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key

# Optional: only used by scripts/check_rls.py to prove the dashboard key cannot write.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: Telegram alerts after each run (free). See src/papertrader/notify.py for setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: set to 1 to stop all NEW buys (exits and stop-losses keep running).
# PAPERTRADER_KILL_SWITCH=1
GROQ_API_KEY=            # optional: free LLM brain via Groq (console.groq.com)
