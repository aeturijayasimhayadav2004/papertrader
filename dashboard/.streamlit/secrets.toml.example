# Copy to dashboard/.streamlit/secrets.toml for local use (gitignored).
# On Streamlit Community Cloud paste the same content into App settings -> Secrets.
# Use the ANON / PUBLISHABLE key here - never the service-role / secret key.

dashboard_password = "choose-a-long-password"

[supabase]
url = "https://your-project-ref.supabase.co"
anon_key = "your-anon-or-publishable-key"
