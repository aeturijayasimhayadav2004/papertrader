# The daily paper run on the always-on server (on time, 16:45 IST). GitHub Actions runs the
# same job hours later as a backup. run_daily.py skips days it already processed, so the
# second runner finds nothing to do (idempotent).
[Unit]
Description=PaperTrader daily paper run (primary; GitHub Actions is the backup)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=papertrader
Group=papertrader
WorkingDirectory=/opt/papertrader
# yfinance and matplotlib caches must live somewhere writable under ProtectSystem=strict.
Environment=XDG_CACHE_HOME=/opt/papertrader/data/.cache MPLCONFIGDIR=/opt/papertrader/data/.mpl
Environment=PAPERTRADER_REQUIRE_SUPABASE=1
ExecStart=/opt/papertrader/.venv/bin/python scripts/run_daily.py
TimeoutStartSec=1200
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/papertrader/data /opt/papertrader/logs -/opt/papertrader/reports
