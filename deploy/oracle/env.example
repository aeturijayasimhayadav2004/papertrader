# Secrets for the VM: /opt/papertrader/.env (chmod 600, owner papertrader). NEVER commit it.
# Edit with:  sudo -u papertrader nano /opt/papertrader/.env

# Supabase (Project Settings -> API). The SERVICE ROLE / secret key can write: keep it on the VM only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Telegram alerts (free). See src/papertrader/notify.py or run scripts/setup_telegram.py on your PC.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: the LLM brain, only used when set.
# ANTHROPIC_API_KEY=

# Optional: 1 stops all NEW paper entries (exits and stops keep running).
# PAPERTRADER_KILL_SWITCH=1
