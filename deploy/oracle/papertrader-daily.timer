# 16:45 IST Monday-Friday (after the 15:45 bar cut-off). Enable once after setup:
#   sudo systemctl enable --now papertrader-daily.timer
[Unit]
Description=PaperTrader daily paper run at 16:45 IST

[Timer]
OnCalendar=Mon..Fri *-*-* 16:45:00 Asia/Kolkata
# Safe to catch up after a reboot: the daily run is idempotent.
Persistent=true
Unit=papertrader-daily.service

[Install]
WantedBy=timers.target
